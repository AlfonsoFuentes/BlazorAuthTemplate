
@using System.Globalization
@using CllientMudBlazor.Pages.Projects._1Starts.StartTemplates

<GenericItemList TItem="RiskMatrixDto"
                 Title="Risk Matrix Register"
                 FilteredItems="FilteredItems"
                 EnableSearch="true"
                 NameFilter="@nameFilter"
                 NameFilterChanged="OnNameFilterChanged"
                 Add="Add" 
                 DisableAdd="DisableAddEdit"
                 HideTable="HideTable">

    <CardHeader Context="item">
        <div class="d-flex align-center justify-space-between w-100">
            <MudText Typo="Typo.h6"><b>#@item.Order</b></MudText>
            
            <MudChip T="string" Color="@GetColor(item.SeverityColor)" Variant="Variant.Filled" Size="Size.Small">
                Score: @item.RiskScore (@item.Probability.ToString() x @item.Impact.ToString())
            </MudChip>
        </div>
    </CardHeader>

    <CardContent Context="item">
        <MudText Typo="Typo.subtitle1" Class="mb-1"><b>@item.Title</b></MudText>
        
        <MudAlert Severity="Severity.Info" Variant="Variant.Text" NoIcon="true" Class="py-1 my-2">
            <MudText Typo="Typo.caption" Style="font-style:italic">
                "Because of <b>@item.Cause</b>, <b>@item.RiskEvent</b> might occur, causing <b>@item.Effect</b>."
            </MudText>
        </MudAlert>

        <div class="d-flex gap-2 my-2">
            <MudTooltip Text="Response Strategy">
                <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Lightbulb">
                    @item.StrategyType.ToString()
                </MudChip>
            </MudTooltip>
            
            <MudTooltip Text="Responsible">
                <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default">
                    @item.Responsible
                </MudChip>
            </MudTooltip>
        </div>

        @if (item.LinkedInvestments != null && item.LinkedInvestments.Any())
        {
            <MudDivider Class="my-2"/>
            <MudText Typo="Typo.caption" Color="Color.Secondary"><b>Mitigation Costs:</b></MudText>
            
           @*  <div class="d-flex flex-wrap gap-1 mt-1">
                @foreach (var inv in item.LinkedInvestments)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">
                        <b>@inv.CategoryName:</b> @inv.BudgetUSD.ToString("C0", new CultureInfo("en-US"))
                    </MudChip>
                }
            </div> *@
            <MudText Typo="Typo.caption" Class="d-block mt-1 text-end">
                Total: <b>@item.LinkedInvestments.Sum(x => x.BudgetUSD).ToString("C0", new CultureInfo("en-US"))</b>
            </MudText>
        }
    </CardContent>

    <CardActions Context="item">
        
        <IconButton ToolTip="Manage Investments / Costs"
                    Color="Color.Primary"
                    OnClick="() => OpenInvestmentsDialog(item)"
                    Disabled="@(DisableAddEdit)"
                    Variant="Variant.Outlined"
                    Icon="@Icons.Material.Outlined.MonetizationOn" />

        <IconButton ToolTip="@($"Order Up {item.Title}")" Color="Color.Info" OnClick="() => OrderUp(item)" Variant="Variant.Outlined" Disabled="@(item.Order == MinOrder||DisableAddEdit)" Icon="@Icons.Material.Outlined.ArrowUpward" />
        <IconButton ToolTip="@($"Order Down {item.Title}")" Color="Color.Info" OnClick="() => OrderDown(item)" Disabled="@(item.Order == MaxOrder||DisableAddEdit)" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.ArrowDownward" />
        <IconButton ToolTip="@($"Edit {item.Title}")" Color="Color.Info" OnClick="() => Edit(item)" Disabled="@(DisableAddEdit)" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Edit" />
        <IconButton ToolTip="@($"Delete {item.Title}")" Color="Color.Warning" Disabled="@(DisableAddEdit)" OnClick="() => Delete(item)" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.DeleteForever" />
    </CardActions>

</GenericItemList>

@code {
    [Parameter]
    public bool DisableAddEdit { get; set; } = false;

    // Helper para convertir el string de color del DTO a Enum de MudBlazor
    private Color GetColor(string colorString)
    {
        return colorString switch
        {
            "Color.Error" => Color.Error,
            "Color.Warning" => Color.Warning,
            "Color.Success" => Color.Success,
            _ => Color.Default
        };
    }

    // ✅ Lógica para abrir inversiones (Reutiliza el concepto de KnownRisk)
    // NOTA: Deberás crear 'RiskMatrixInvestmentsDialog' o adaptar el de KnownRisk para que sea genérico
    async Task OpenInvestmentsDialog(RiskMatrixDto item)
    {
        /*
           Aquí llamaremos al diálogo de inversiones. 
           Como paso siguiente, debemos asegurarnos de tener el Dialogo listo 
           que acepte 'RiskMatrixId' en lugar de 'KnownRiskId'.
        */
         var parameters = new DialogParameters<RiskMatrixInvestmentsDialog>
        {
            { x => x.RiskMatrixId, item.Id },
            { x => x.RiskTitle, item.Title },
            { x => x.ProjectId, ProjectId },
            { x => x.DisableAddEdit, DisableAddEdit }
        };

        var options = new DialogOptions() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<RiskMatrixInvestmentsDialog>("Mitigation Costs", parameters, options);
        var result = await dialog.Result;
        
        await GetAll(); // Recargar para actualizar totales
    }
    [Parameter]
    public EventCallback HideTable { get; set; }
    async Task OnHideTable()
    {
        if (HideTable.HasDelegate) await HideTable.InvokeAsync();
    }
}

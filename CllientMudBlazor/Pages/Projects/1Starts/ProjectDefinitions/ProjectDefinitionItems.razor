<TemplateCard2 TValue="ProjectDefinitionItemDto"
              Title="@Type.GetDescription()"
              Items="@_items"
              Model="@Model"
              IsLoading="_loading"
              Create="StartCreate"
              Edit="StartEdit"
              Delete="DeleteAsync"
              Submit="Submit"
              Cancel="Cancel"
              GoUp="OrderUp"
              DisableAddEdit=@DisableAddEdit
              GoDown="OrderDown">

    <FormContent Context="ctx">
        <MudGrid>
            <MudItem xs="12">
                <TextField @bind-Value="@ctx.Model.Name"
                           Label="Name"
                           Lines="3"
                           ValidateAsync="@ctx.ValidateAsync"
                           For="@(() => ctx.Model.Name)">
                </TextField>
            </MudItem>


        </MudGrid>
    </FormContent>

    <MainContent Context="item">
        <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">@item.Name</MudText>

    </MainContent>

</TemplateCard2>


@code {
    [Parameter]
    public bool DisableAddEdit { get; set; } = false;
}
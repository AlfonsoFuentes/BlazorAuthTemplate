


<GenericItemList TItem="KnownRiskDto"
                 Title="@Title"
                 FilteredItems="FilteredItems"
                 EnableSearch="true"
                 NameFilter="@nameFilter"
                 NameFilterChanged="OnNameFilterChanged"
                 Add="Add" DisableAdd="DisableAddEdit"
                 HideTable="HideTable">

    <CardHeader Context="item">
        <MudText Typo="Typo.subtitle1"><strong>@item.Order</strong></MudText>
    </CardHeader>

    <CardContent Context="item">
        <MudText Typo="Typo.subtitle2">@item.Name</MudText>
       @*  @if (item.LinkedInvestments != null && item.LinkedInvestments.Any())
        {
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                <b>Mitigation Strategy (Investments):</b>
            </MudText>

            <div class="d-flex flex-wrap gap-1 mt-1">
                @foreach (var inv in item.LinkedInvestments)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">
                        <b>@inv.CategoryName:</b> @inv.BudgetUSD.ToString("C0", new CultureInfo("en-US"))
                    </MudChip>
                }
            </div>

            <MudText Typo="Typo.caption" Class="d-block mt-1 text-end">
                Total: <b>@item.LinkedInvestments.Sum(x => x.BudgetUSD).ToString("C0", new CultureInfo("en-US"))</b>
            </MudText>
        } *@
    </CardContent>

    <CardActions Context="item">
        <IconButton ToolTip="Manage Investments"
                    Color="Color.Primary"
                    OnClick="() => OpenInvestmentsDialog(item)"
                    Disabled="@(DisableAddEdit)"
                    Variant="Variant.Outlined"
                    Icon="@Icons.Material.Outlined.MonetizationOn" />
        <IconButton ToolTip="@($"Order Up {item.Name}")"
                    Color="Color.Info"
                    OnClick="() => OrderUp(item)"
                    Variant="Variant.Outlined" Disabled="@(item.Order == MinOrder||DisableAddEdit)"
                    Icon="@Icons.Material.Outlined.ArrowUpward" />

        <IconButton ToolTip="@($"Order Down {item.Name}")"
                    Color="Color.Info"
                    OnClick="() => OrderDown(item)" Disabled="@(item.Order == MaxOrder||DisableAddEdit)"
                    Variant="Variant.Outlined"
                    Icon="@Icons.Material.Outlined.ArrowDownward" />

        <IconButton ToolTip="@($"Edit {item.Name}")"
                    Color="Color.Info"
                    OnClick="() => Edit(item)" Disabled="@DisableAddEdit"
                    Variant="Variant.Outlined"
                    Icon="@Icons.Material.Outlined.Edit" />

        <IconButton ToolTip="@($"Delete {item.Name}")"
                    Color="Color.Warning"
                    OnClick="() => Delete(item)" Disabled="@DisableAddEdit"
                    Variant="Variant.Outlined"
                    Icon="@Icons.Material.Outlined.DeleteForever" />
    </CardActions>
</GenericItemList>

@code {

      [Parameter]
    public bool DisableAddEdit { get; set; } = false;
    // 🔹 Filtro gestionado aquí (como querías)

    [Parameter]
    public EventCallback HideTable { get; set; }
    async Task OnHideTable()
    {
        if (HideTable.HasDelegate) await HideTable.InvokeAsync();
    }
    async Task OpenInvestmentsDialog(KnownRiskDto item)
    {
        var parameters = new DialogParameters<KnownRiskInvestmentsDialog>
        {
            { x => x.RiskId, item.Id },
            { x => x.RiskName, item.Name },
            { x => x.ProjectId, ProjectId },
            { x => x.DisableAddEdit, DisableAddEdit }
        };

        var options = new DialogOptions()
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        };

        // Abrimos el diálogo que acabamos de terminar
        var dialog = await DialogService.ShowAsync<KnownRiskInvestmentsDialog>("Manage Investments", parameters, options);
        var result = await dialog.Result;

        // 🔄 Recargamos la lista principal al cerrar para ver los Chips actualizados
        await GetAll();
    }
   
}
@using Shared.Enums.RequirementPrioritys
<TemplateCard2 TValue="RequirementDto"
               Title="@Title"
               Items="@_items"
               Model="@Model"
               IsLoading="_loading"
               Create="StartCreate"
               Edit="StartEdit"
               Delete="DeleteAsync"
               Submit="Submit"
               Cancel="Cancel"
               GoUp="OrderUp"
               DisableAddEdit=@DisableAddEdit
               GoDown="OrderDown">

    <FormContent Context="ctx">
        <MudGrid>
            <MudItem xs="12">
                <TextField @bind-Value="@ctx.Model.Name"
                           Label="Name"
                           Lines="3"
                           ValidateAsync="@ctx.ValidateAsync"
                           For="@(() => ctx.Model.Name)">
                </TextField>
            </MudItem>
            <MudItem xs="12" sm="6">
                <AutoCompleteIconButton @bind-Value="@ctx.Model.RequestedBy"
                                        TValue="StakeHolderDto"
                                        Label="Select Requestor"
                                        ValidateAsync="ctx.ValidateAsync"
                                        For="()=>ctx.Model.RequestedBy"
                                        Clearable="true"
                                        SearchFunc="SearchStakeHolder"
                                        ToStringFunc="@(e=> e==null?null : $"{e.Name} ")"
                                        Icon="@Icons.Material.Filled.Add"
                                        ButtonClick="AddStakeHolder"
                                        ToolTip="Add new Requestor"
                                        Change="ChangeRequeridBy">

                </AutoCompleteIconButton>


            </MudItem>
            <MudItem xs="12" sm="6">
                <AutoCompleteIconButton @bind-Value="@ctx.Model.Responsible"
                                        TValue="StakeHolderDto"
                                        Label="Select Responsible"
                                        ValidateAsync="ctx.ValidateAsync"
                                        For="()=>ctx.Model.Responsible"
                                        Clearable="true"
                                        SearchFunc="SearchStakeHolder"
                                        ToStringFunc="@(e=> e==null?null : $"{e.Name} ")"
                                        Icon="@Icons.Material.Filled.Add"
                                        ButtonClick="AddStakeHolder"
                                        ToolTip="Add new Responsible"
                                        Change="ChangeResponsible">

                </AutoCompleteIconButton>


            </MudItem><MudItem xs="12" sm="6">
                <Select @bind-Value="ctx.Model.Type"
                        TValue="RequirementTypeEnum"
                        Label="Requirement Type"
                        Items="RequirementTypeEnum.List.ToList()"
                        For="@(() => ctx.Model.Type)" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <Select @bind-Value="ctx.Model.Priority"
                        TValue="RequirementPriorityEnum"
                        Label="Priority"
                        Items="RequirementPriorityEnum.List.ToList()"
                        For="@(() => ctx.Model.Priority)" />
            </MudItem>


        </MudGrid>
    </FormContent>

    <MainContent Context="item">
        <div class="d-flex align-center w-100">

            <div class="d-flex flex-column flex-grow-1">
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">@item.Name</MudText>

                </div>

                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.caption" Color="Color.Default">Requested by: @item.RequestedByName</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Default">|</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Default" Style="opacity:0.7;">Responsible: @item.ResponsibleName</MudText>
                </div>
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.caption" Color="Color.Default" Style="opacity:0.7;">Type: @item.Type.Name</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Default">|</MudText>
                    <MudText Typo="Typo.caption" Style="@($"background-color:white; color:{item.Priority.Color};")">@item.Priority.Name</MudText>
                   
                </div>
                <div class="mt-2">
                    <MudText Typo="Typo.caption" Color="Color.Dark" Style="text-transform: uppercase; letter-spacing: 1px; font-weight: bold;">
                        Mitigation Strategy (Investments)
                    </MudText>
                    <IconButton ToolTip="Manage Investments"
                                Color="Color.Primary"
                                OnClick="() => OpenInvestmentsDialog(item)"
                                Disabled="@(DisableAddEdit)"
                                Size="Size.Small"
                                Variant="Variant.Filled"
                                Icon="@Icons.Material.Outlined.Add" />
                </div>

                @* FILA 3: LISTADO VERTICAL DE INVERSIONES *@
                @if (item.LinkedInvestments != null && item.LinkedInvestments.Any())
                {
                    <div class="d-flex flex-column gap-1 mt-1">
                        @foreach (var inv in item.LinkedInvestments)
                        {
                            <div class="d-flex align-center justify-space-between pa-1 px-2 mud-background-gray rounded">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">
                                        <b>@inv.Category.GetDescription():</b> @inv.Name
                                    </MudText>
                                </div>
                                <MudText Typo="Typo.body2" Style="font-family: monospace; font-weight: 600;">
                                    @inv.BudgetUSD.ToCurrencyCulture()
                                </MudText>
                            </div>
                        }
                    </div>

                    @* FILA 4: GRAN TOTAL *@
                    <div class="d-flex justify-end mt-2 pt-2 border-t-2 border-solid mud-border-lines-default">
                        <MudText Typo="Typo.subtitle2">
                            GRAND TOTAL: <b class="ml-2" style="font-size: 1.1rem; color: var(--mud-palette-primary);">
                                @item.LinkedInvestments.Sum(x => x.BudgetUSD).ToCurrencyCulture()
                            </b>
                        </MudText>
                    </div>
                }
                else
                {
                    <MudAlert Severity="Severity.Normal" Variant="Variant.Text" Dense="true" Class="mt-1">
                        No investments linked yet.
                    </MudAlert>
                }
            </div>
            
        </div>


    </MainContent>

</TemplateCard2>


@code {
    [Parameter]
    public bool DisableAddEdit { get; set; } = false;
}
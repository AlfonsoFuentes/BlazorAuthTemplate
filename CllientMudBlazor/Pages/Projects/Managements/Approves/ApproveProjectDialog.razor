@using Shared.Enums.CostCenter
@using Shared.Enums.Focuses
<EditForm Model="@Model" OnValidSubmit="Submit">
    <MudCard>
        <MudCardContent>

            <FluentValidationValidator @ref="_fluentValidationValidator" />
            <ValidationSummary></ValidationSummary>
            <MudGrid>
                <MudItem xs="12" sm="12">
                    <TextField @bind-Value="@Model.ProjectName"
                               Label="Name"
                               Lines="2"
                               ValidateAsync="ValidateAsync"
                               For="()=>Model.ProjectName">
                    </TextField>
                    <ValidationMessage For="() => Model.BudgetItems" style="color:red; font-size:x-small;" />
                    <ValidationMessage For="() => Model.Stakeholders" style="color:red; font-size:x-small;" />
                    <ValidationMessage For="() => Model.Backgrounds" style="color:red; font-size:x-small;" />
                    <ValidationMessage For="() => Model.Objectives" style="color:red; font-size:x-small;" />
                    <ValidationMessage For="() => Model.Scopes" style="color:red; font-size:x-small;" />
                    <ValidationMessage For="() => Model.AcceptenceCriterias" style="color:red; font-size:x-small;" />
                    <ValidationMessage For="() => Model.Requirements" style="color:red; font-size:x-small;" />
             
                </MudItem>
               
               

            </MudGrid>


        </MudCardContent>
        <MudCardActions>

            <MudIconButton Icon="@Icons.Material.Filled.Cancel" OnClick="Cancel" Color="Color.Transparent" Variant="Variant.Outlined"></MudIconButton>
            <MudIconButton Icon="@Icons.Material.Filled.Save" Disabled=!Validated ButtonType="ButtonType.Submit" Variant="Variant.Outlined"></MudIconButton>

        </MudCardActions>
    </MudCard>
</EditForm>

